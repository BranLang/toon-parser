{
  "name": "toon-parser",
  "version": "3.0.1",
  "description": "Safe JSON <-> TOON encoder/decoder with strict validation.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "require": "./dist/csv.cjs"
    },
    "./xml": {
      "types": "./dist/xml.d.ts",
      "import": "./dist/xml.js",
      "require": "./dist/xml.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "import": "./dist/log.js",
      "require": "./dist/log.cjs"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js",
      "require": "./dist/url.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.bench.*",
    "!dist/bench/**",
    "!dist/cjs/**/*.test.*",
    "!dist/cjs/**/*.bench.*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:js": "tsc -p tsconfig.json",
    "build:cjs": "node ./scripts/build-cjs.mjs && node ./scripts/build-copy-cjs-output.js",
    "build": "npm run typecheck && npm run build:types && npm run build:js && npm run build:cjs",
    "clean": "rimraf dist",
    "clean:node": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "lint": "eslint src",
    "verify-docs": "node scripts/verify-docs.js",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage"
  },
  "keywords": [
    "json",
    "toon",
    "parser",
    "encoder",
    "decoder",
    "secure"
  ],
  "author": "Branislav Lang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BranLang/toon-parser.git"
  },
  "bugs": {
    "url": "https://github.com/BranLang/toon-parser/issues"
  },
  "homepage": "https://github.com/BranLang/toon-parser#readme",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "esbuild": "^0.27.7",
    "fast-check": "^4.7.0",
    "rimraf": "^6.1.3",
    "eslint": "^10.3.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-xml-parser": "^5.7.2",
    "node-html-parser": "^7.1.0"
  }
}
