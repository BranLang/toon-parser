{
  "name": "json-toon-parser",
  "version": "3.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.27.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BranLang/toon-parser"
  },
  "bugs": {
    "url": "https://github.com/BranLang/toon-parser/issues"
  },
  "homepage": "https://github.com/BranLang/toon-parser#readme",
  "scripts": {
    "build": "npm run build -w toon-parser",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "lint": "tsc -b packages/toon-parser",
    "example": "npm run build && npm run start -w json-toon-example",
    "smoke": "npm run build && node examples/basic/index.mjs > /dev/null && node examples/extensions/index.mjs > /dev/null && echo '✓ examples smoke ok'",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
